# Copy this file to .env and fill in your values.
# .env is never committed (see .gitignore) and never sent to the browser.

# Random long string used to sign the login cookie (JWT). Any long random text works.
SESSION_SECRET=change-this-to-a-long-random-string

# Port the server listens on locally.
PORT=3000

# Set this to "production" when deploying (e.g. on Netlify) so the login
# cookie requires HTTPS. Leave unset for local http://localhost dev.
NODE_ENV=

# --- Google Sheets (live data) -----------------------------------------
# Leave these blank to run in demo mode using the bundled sample data.
# See README.md "Connect your Google Sheet" for how to get these values.

GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value from the downloaded JSON key file, keeping
# the \n sequences literally as \n (do not turn them into real line breaks).
GOOGLE_PRIVATE_KEY=

# How long fetched sheet data is cached in memory before re-fetching (ms).
CACHE_TTL_MS=300000
